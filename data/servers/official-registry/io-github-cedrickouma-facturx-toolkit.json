{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "official-registry/io-github-cedrickouma-facturx-toolkit",
  "description": "Validate, extract, repair and generate French Factur-X / EN16931 invoices via AgentForge API",
  "version": "0.1.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://apim-agentforge-6lfm33.azure-api.net/facturx/mcp",
      "headers": [
        {
          "description": "APIM subscription key (free tier works for smoke tests)",
          "isRequired": true,
          "isSecret": true,
          "name": "Ocp-Apim-Subscription-Key"
        }
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "agentforge-facturx-mcp",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "AgentForge APIM gateway base URL",
          "format": "string",
          "name": "AGENTFORGE_BASE_URL"
        },
        {
          "description": "APIM subscription key (Ocp-Apim-Subscription-Key / x-api-key)",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "AGENTFORGE_API_KEY"
        }
      ]
    }
  ],
